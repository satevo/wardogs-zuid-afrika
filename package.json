{
  "name": "wardogs-zuid-afrika",
  "version": "1.0.0",
  "private": true,
  "description": "Wardogs Zuid Afrika community website and local launcher",
  "scripts": {
    "start": "node local-server.mjs --open",
    "serve": "node local-server.mjs",
    "stop": "node stop-local.mjs",
    "test": "node --test test/*.test.mjs",
    "setup:paypal": "node setup-paypal.mjs",
    "preview:cloudflare": "node cloudflare-preview.mjs",
    "sync:offers": "node scripts/sync-offers.mjs",
    "build:cloudflare": "node scripts/sync-offers.mjs && node scripts/build-cloudflare.mjs",
    "start:hosted": "node app.cjs"
  },
  "engines": {
    "node": ">=22"
  }
}
