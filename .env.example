# Copy to .env locally. Never commit .env or paste private keys into chat.
SITE_URL=http://localhost:1026

# Create a Discord application and register this exact OAuth2 redirect URL:
# http://localhost:1026/auth/discord/callback
# Use your public HTTPS domain's callback when hosting publicly.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# PayPal developer dashboard > Apps & Credentials > SANDBOX.
# A real Business account is separate from these test credentials.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# setup-paypal.mjs stores all 6 offer/period IDs in .local/paypal-sandbox.json.
# Optional per-plan override format: PAYPAL_PLAN_RESERVED_ONE_SERVER_1M=
PAYPAL_WEBHOOK_ID=

# Hosted app.cjs uses hosting-panel environment variables, not this file.
# Set SITE_URL to the public HTTPS origin and keep PAYPAL_ENVIRONMENT=sandbox.
# WARDOGS_DATA_DIR must be an absolute private persistent directory outside dist.
# WARDOGS_DATA_DIR=
# PORT is managed by the hosting platform; local launching stays on 1026.
